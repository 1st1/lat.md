{
  "name": "@lat.md/embed-minilm-fp16",
  "version": "0.1.0",
  "description": "all-MiniLM-L6-v2 weights (fp16 safetensors) + tokenizer, packaged as a model manifest for @lat.md/embed",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Yury Selivanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/1st1/lat.md.git",
    "directory": "packages/embed-minilm-fp16"
  },
  "keywords": [
    "embeddings",
    "minilm",
    "safetensors",
    "lat.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "model/model.fp16.safetensors",
    "model/tokenizer.json",
    "model/config.json"
  ],
  "scripts": {
    "build": "node scripts/build-weights.mjs && tsc",
    "build:weights": "node scripts/build-weights.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lat.md/embed": "workspace:*"
  }
}
